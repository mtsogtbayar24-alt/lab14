        {
          "name": "GET User by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"User has email property\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"email\");",
                  "});",
                  "",
                  "pm.test(\"Email is a valid format (contains @)\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.email).to.be.a(\"string\").and.match(/@/);",
                  "});",
                  "",
                  "pm.test(\"Username is a string\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.username).to.be.a(\"string\");",
                  "});"
                ]
              }
