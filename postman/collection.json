{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Munguntuya — JSONPlaceholder",
    "description": "F.CSM311 Lab 14 — Integration & API Testing with JSONPlaceholder (https://jsonplaceholder.typicode.com)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Posts",
      "description": "CRUD operations on /posts resource",
      "item": [
        {
          "name": "GET All Posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time < 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Body is an array\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"First item has required properties\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json[0]).to.have.property(\"id\");",
                  "    pm.expect(json[0]).to.have.property(\"title\");",
                  "    pm.expect(json[0]).to.have.property(\"userId\");",
                  "    // Chain: save first post ID for use in GET Post by ID",
                  "    pm.environment.set(\"firstPostId\", json[0].id);",
                  "});",
                  "",
                  "pm.test(\"Content-Type header is JSON\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": ["{{baseUrl}}"],
              "path": ["posts"]
            },
            "description": "Retrieve all posts — happy path list request"
          },
          "response": []
        },
        {
          "name": "GET Post by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Post has correct ID\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    pm.expect(json.id).to.eql(1);",
                  "});",
                  "",
                  "pm.test(\"title is a string\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.title).to.be.a(\"string\");",
                  "});",
                  "",
                  "pm.test(\"userId is a number\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.userId).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{firstPostId}}",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "{{firstPostId}}"]
            },
            "description": "Retrieve a single post by ID — uses {{firstPostId}} chained from GET All Posts"
          },
          "response": []
        },
        {
          "name": "POST Create Post",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate random userId and unique title for the new post",
                  "const randomUserId = Math.floor(Math.random() * 10) + 1;",
                  "pm.environment.set(\"randomUserId\", randomUserId);",
                  "pm.environment.set(\"newPostTitle\", \"Test Post \" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has an id — save to environment\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    pm.environment.set(\"createdPostId\", json.id);",
                  "});",
                  "",
                  "pm.test(\"id is a number\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.id).to.be.a(\"number\");",
                  "});",
                  "",
                  "pm.test(\"Response includes submitted title\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"title\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{newPostTitle}}\",\n  \"body\": \"This is a test post body.\",\n  \"userId\": {{randomUserId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": ["{{baseUrl}}"],
              "path": ["posts"]
            },
            "description": "Create a new post — pre-request script generates random data; test script chains createdPostId to next requests"
          },
          "response": []
        },
        {
          "name": "PUT Update Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has id property\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "});",
                  "",
                  "pm.test(\"Title is updated correctly\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.title).to.eql(\"Updated Title\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"title\": \"Updated Title\",\n  \"body\": \"Updated body content.\",\n  \"userId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "1"]
            },
            "description": "Update post ID 1 — JSONPlaceholder does not persist POST data so a known-valid ID is used here"
          },
          "response": []
        },
        {
          "name": "DELETE Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time < 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "1"]
            },
            "description": "Delete a post — verifies 200 status and response time"
          },
          "response": []
        }
      ]
    },
